/---
=UpdateContext({ locExporting: true });
With(
    { lines: Filter(IGCELine_IGCE_SPList, IGCEHeaderID = glIGCE.ID) },
    // Each line's sublines, with the line's number, description and category
    Clear(colExportSublines);
    ForAll(
        lines As l,
        Collect(
            colExportSublines,
            ShowColumns(
                AddColumns(
                    Filter(IGCESubLine_IGCE_SPList, IGCELineID = l.ID),
                    LineNumber, l.LineNumber,
                    LineDescription, l.Description,
                    CategoryName, l.Category.Value,
                    TypeName, SublineType.Value,
                    UnitsName, Units.Value,
                    OtherCostsCategoryName, OtherCostsCategory.Value,
                    PropertyTypeName, PropertyType.Value
                ),
                LineNumber,
                LineDescription,
                CategoryName,
                Title,
                TypeName,
                UnitsName,
                OtherCostsCategoryName,
                PropertyTypeName,
                IncludesProperty,
                SerialNumber,
                Software,
                BaseYearQuantity,
                BaseYearRate,
                BaseYearTotalCost,
                OP1Quantity,
                OP1Rate,
                OP1TotalCost,
                OP2Quantity,
                OP2Rate,
                OP2TotalCost,
                OP3Quantity,
                OP3Rate,
                OP3TotalCost,
                OP4Quantity,
                OP4Rate,
                OP4TotalCost,
                TotalCost,
                TotalAccountableProperty,
                BaseYearFringe,
                BaseYearOverhead,
                BaseYearGAndA,
                BaseYearFCCOM,
                OP1Fringe,
                OP1Overhead,
                OP1GAndA,
                OP1FCCOM,
                OP2Fringe,
                OP2Overhead,
                OP2GAndA,
                OP2FCCOM,
                OP3Fringe,
                OP3Overhead,
                OP3GAndA,
                OP3FCCOM,
                OP4Fringe,
                OP4Overhead,
                OP4GAndA,
                OP4FCCOM
            )
        )
    );
    With(
        {
            result: IGCEExportExcelTables.Run(
                JSON(
                    {
                        Header: First(
                            ShowColumns(
                                AddColumns(
                                    Table(glIGCE),
                                    Key, "h",
                                    PRNumber, glPRTracker,
                                    RequirementName, LookUp(RequirementTracker_IGCE_SPList, ID = Value(glPRID)).Title,
                                    IGCETypeName, IGCEType.Value,
                                    StatusName, Status.Value,
                                    POCName, PointOfContact.DisplayName,
                                    CORName, COR.DisplayName,
                                    BaseStart, Text(BasePeriodStart, "mm/dd/yyyy"),
                                    BaseEnd, Text(BasePeriodEnd, "mm/dd/yyyy"),
                                    OP1Start, Text(OptionPeriod1Start, "mm/dd/yyyy"),
                                    OP1End, Text(OptionPeriod1End, "mm/dd/yyyy"),
                                    OP2Start, Text(OptionPeriod2Start, "mm/dd/yyyy"),
                                    OP2End, Text(OptionPeriod2End, "mm/dd/yyyy"),
                                    OP3Start, Text(OptionPeriod3Start, "mm/dd/yyyy"),
                                    OP3End, Text(OptionPeriod3End, "mm/dd/yyyy"),
                                    OP4Start, Text(OptionPeriod4Start, "mm/dd/yyyy"),
                                    OP4End, Text(OptionPeriod4End, "mm/dd/yyyy"),
                                    PreparedBy, User().FullName,
                                    PreparedOn, Text(Now(), "mm/dd/yyyy h:mm AM/PM")
                                ),
                                Key,
                                PRNumber,
                                Title,
                                PRID,
                                RequirementName,
                                IGCETypeName,
                                StatusName,
                                POCName,
                                CORName,
                                OptionPeriods,
                                BaseStart,
                                BaseEnd,
                                OP1Start,
                                OP1End,
                                OP2Start,
                                OP2End,
                                OP3Start,
                                OP3End,
                                OP4Start,
                                OP4End,
                                FringeRate,
                                OverheadRate,
                                GAndARate,
                                FCCOMRate,
                                ProfitFeeRate,
                                ContractAccessFeeRate,
                                InflationRate,
                                TotalAccountableProperty,
                                ContainsGFP,
                                GFPQ1,
                                GFPQ2,
                                GFPQ3,
                                GFPQ4,
                                GFPQ5,
                                GFPQ6,
                                InformationObtainedFrom,
                                InformationToolsUsed,
                                PreviousContracts,
                                LaborBasis,
                                LaborCategoriesBasis,
                                LaborRatesBasis,
                                HoursBasis,
                                UnburdenedDirectLaborBasis,
                                IndirectRatesBasis,
                                GAndABasis,
                                FCCOMBasis,
                                FixedFeeBasis,
                                IndirectBurdenBasis,
                                DirectMaterialBasis,
                                ProductsSuppliesBasis,
                                SubcontractsBasis,
                                ODCBasis,
                                TravelBasis,
                                Assumptions,
                                PreparedBy,
                                PreparedOn
                            )
                        ),
                        Lines: ShowColumns(
                            AddColumns(
                                lines,
                                CategoryName, Category.Value
                            ),
                            ID,
                            LineNumber,
                            Description,
                            CategoryName,
                            BaseYearQuantity,
                            BaseYearTotalCost,
                            OP1Quantity,
                            OP1TotalCost,
                            OP2Quantity,
                            OP2TotalCost,
                            OP3Quantity,
                            OP3TotalCost,
                            OP4Quantity,
                            OP4TotalCost,
                            TotalCost,
                            TotalAccountableProperty
                        ),
                        Sublines: colExportSublines,
                        PRNumber: glPRTracker,
                        Email: User().Email
                    },
                    JSONFormat.IgnoreBinaryData
                ),
                "IGCE " & glPRTracker & " " & Text(Now(), "yyyy-mm-dd hhmmss") & ".xlsx"
            )
        },
        // The flow answers once the empty workbook exists and emails the link when it is filled.
        If(
            result.ok,
            Notify(result.message, NotificationType.Success, 6000),
            Notify(Coalesce(result.message, "The export failed."), NotificationType.Error, 6000)
        )
    )
);
UpdateContext({ locExporting: false })
